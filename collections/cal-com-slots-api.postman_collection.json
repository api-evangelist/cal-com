                    },
                    {
                      "key": "duration",
                      "value": "<number>"
                    },
                    {
                      "key": "timeZone",
                      "value": "Europe/Rome"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "(Required) Must be set to 2024-09-04. If not set to this value, the endpoint will default to an older version.",
                    "key": "cal-api-version",
                    "value": "2024-09-04"
                  },
                  {
