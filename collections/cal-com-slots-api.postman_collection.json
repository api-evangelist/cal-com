          "request": {
            "name": "Reserve a slot",
            "description": {
              "content": "Make a slot not available for others to book for a certain period of time. If you authenticate using oAuth credentials, api key or access token\n    then you can also specify custom duration for how long the slot should be reserved for (defaults to 5 minutes).\n    \n    <Note>Please make sure to pass in the cal-api-version header value as mentioned in the Headers section. Not passing the correct value will default to an older version of this endpoint.</Note>    \n    ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "slots",
                "reservations"
