          "id": "6fe157e8-709b-4add-bda5-6ce92ac22bc9",
          "name": "Exchange authorization code or refresh token for tokens",
          "request": {
            "name": "Exchange authorization code or refresh token for tokens",
            "description": {
              "content": "RFC 6749-compliant token endpoint. Pass client_id in the request body (Section 2.3.1). Use grant_type 'authorization_code' to exchange an auth code for tokens, or 'refresh_token' to refresh an access token. Accepts both application/x-www-form-urlencoded (standard per RFC 6749 Section 4.1.3) and application/json content types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "auth",
                "oauth2",
                "token"
              ],
              "host": [
