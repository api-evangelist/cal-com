                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKeyDaysValid\": 30,\n  \"apiKeyNeverExpires\": \"<boolean>\"\n}",
              "options": {
